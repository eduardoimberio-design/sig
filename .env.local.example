# URL pública da aplicação (usada em redirect e webhook)
# Local: http://localhost:3000 | Produção: https://app.seudominio.com.br
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (console.anthropic.com > API Keys)
ANTHROPIC_API_KEY=

# InfinitePay — sua InfiniteTag, SEM o "$" na frente
INFINITEPAY_HANDLE=

# 360dialog (Módulo 5 — WhatsApp)
DIALOG360_API_KEY=
DIALOG360_CHANNEL_ID=
